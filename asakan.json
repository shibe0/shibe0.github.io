[
 {
  "no": 44,
  "date": "2026-10-27",
  "title": "バナナ",
  "line": "自分でむくと言ったバナナが折れて、もう一本むく朝。",
  "image": "asakan/2026-10-27.jpg",
  "url": "https://substack.com/@shibe0/note/c-371094413"
 },
 {
  "no": 43,
  "date": "2026-10-26",
  "title": "おばけ",
  "line": "シーツのおばけが、一歳の妹にあっさりめくられる朝。",
  "image": "asakan/2026-10-26.jpg",
  "url": "https://substack.com/@shibe0/note/c-370229308"
 },
 {
  "no": 42,
  "date": "2026-10-25",
  "title": "せんたくもの",
  "line": "たたみ終えた洗濯物の山が、そのままプールになる日曜の朝。",
  "image": "asakan/2026-10-25.jpg",
  "url": "https://substack.com/@shibe0/note/c-369429799"
 },
 {
  "no": 41,
  "date": "2026-10-24",
  "title": "えほん",
  "line": "まだ字は読めないのに、とばしたページにだけは気づく休日の朝。",
  "image": "asakan/2026-10-24.jpg",
  "url": "https://substack.com/@shibe0/note/c-368662187"
 },
 {
  "no": 40,
  "date": "2026-10-23",
  "title": "ないしょ",
  "line": "ママにはないしょと言った花を、三分後に自分で届けにくる夕方。",
  "image": "asakan/2026-10-23.jpg",
  "url": "https://substack.com/@shibe0/note/c-367787613"
 },
 {
  "no": 39,
  "date": "2026-10-22",
  "title": "てつなぎ",
  "line": "つながないと言った手を、大きな犬の前でだけぎゅっとにぎる朝。",
  "image": "asakan/2026-10-22.jpg",
  "url": "https://substack.com/@shibe0/note/c-366934003"
 },
 {
  "no": 38,
  "date": "2026-10-21",
  "title": "あいさつ",
  "line": "声をかけられると隠れて、扉が閉まってから大きな声であいさつする朝。",
  "image": "asakan/2026-10-21.jpg",
  "url": "https://substack.com/@shibe0/note/c-366076869"
 },
 {
  "no": 37,
  "date": "2026-10-20",
  "title": "うわぎ",
  "line": "いらないと言った上着の代わりに、ママの上着で出かける朝。",
  "image": "asakan/2026-10-20.jpg",
  "url": "https://substack.com/@shibe0/note/c-365211767"
 },
 {
  "no": 36,
  "date": "2026-10-19",
  "title": "ごみのひ",
  "line": "ゴミ収集車にみんなで手を振って、ゴミだけ家に連れて帰る月曜の朝。",
  "image": "asakan/2026-10-19.jpg",
  "url": "https://substack.com/@shibe0/note/c-364379031"
 },
 {
  "no": 35,
  "date": "2026-10-18",
  "title": "おさんぽ",
  "line": "誘っても行かないお散歩に、ママが座ったとたん出発する日曜の朝。",
  "image": "asakan/2026-10-18.jpg",
  "url": "https://substack.com/@shibe0/note/c-363598684"
 },
 {
  "no": 34,
  "date": "2026-10-17",
  "title": "ホットケーキ",
  "line": "きれいに焼けた方が余って、くずれた一枚を取り合う休日の朝。",
  "image": "asakan/2026-10-17.jpg",
  "url": "https://substack.com/@shibe0/note/c-362826516"
 },
 {
  "no": 33,
  "date": "2026-10-16",
  "title": "ボタン",
  "line": "エレベーターのボタンを押したい人が二人いると、全部の階に止まる朝。",
  "image": "asakan/2026-10-16.jpg",
  "url": "https://substack.com/@shibe0/note/c-361994713"
 },
 {
  "no": 32,
  "date": "2026-10-15",
  "title": "おやつ",
  "line": "台所でこっそり開けたチョコの音だけは、遠くの部屋まで届く夕方。",
  "image": "asakan/2026-10-15.jpg",
  "url": "https://substack.com/@shibe0/note/c-361155013"
 },
 {
  "no": 31,
  "date": "2026-10-14",
  "title": "ねぐせ",
  "line": "子どもの寝ぐせを全部直して、自分の寝ぐせのまま出かけそうになる朝。",
  "image": "asakan/2026-10-14.jpg",
  "url": "https://substack.com/@shibe0/note/c-360293271"
 },
 {
  "no": 30,
  "date": "2026-10-13",
  "title": "ながぐつ",
  "line": "晴れの日に長靴をはいていく子は、ちゃんと水たまりを見つける朝。",
  "image": "asakan/2026-10-13.jpg",
  "url": "https://substack.com/@shibe0/note/c-359442699"
 },
 {
  "no": 29,
  "date": "2026-10-12",
  "title": "かけっこ",
  "line": "勝たせてあげた一本目から、もう一回が終わらない休日の朝。",
  "image": "asakan/2026-10-12.jpg",
  "url": "https://substack.com/@shibe0/note/c-358622440"
 },
 {
  "no": 28,
  "date": "2026-10-11",
  "title": "にがおえ",
  "line": "描いてくれたママの似顔絵が、いちばん似ているのは怒った顔の日曜日。",
  "image": "asakan/2026-10-11.jpg",
  "url": "https://substack.com/@shibe0/note/c-357840522"
 },
 {
  "no": 27,
  "date": "2026-10-10",
  "title": "ダンボール",
  "line": "やっと届いたおもちゃより、入っていた箱で遊ぶ休日の朝。",
  "image": "asakan/2026-10-10.jpg",
  "url": "https://substack.com/@shibe0/note/c-357082773"
 },
 {
  "no": 26,
  "date": "2026-10-09",
  "title": "どんぐり",
  "line": "宝物だと持ち帰ったどんぐりから、先客が出てくる夜。",
  "image": "asakan/2026-10-09.jpg",
  "url": "https://substack.com/@shibe0/note/c-356259270"
 },
 {
  "no": 25,
  "date": "2026-10-08",
  "title": "わすれもの",
  "line": "忘れ物と言われて青ざめたら、いってきますのぎゅうだった朝。",
  "image": "asakan/2026-10-08.jpg",
  "url": "https://substack.com/@shibe0/note/c-355430571"
 },
 {
  "no": 24,
  "date": "2026-10-07",
  "title": "なんで？",
  "line": "靴をはいてと言うたびに、なんでが一つずつ増えていく朝。",
  "image": "asakan/2026-10-07.jpg",
  "url": "https://substack.com/@shibe0/note/c-354592079"
 },
 {
  "no": 23,
  "date": "2026-10-06",
  "title": "まねっこ",
  "line": "お兄ちゃんの「いやだ」を、妹がそっくりまねして二人分になる朝。",
  "image": "asakan/2026-10-06.jpg",
  "url": "https://substack.com/@shibe0/note/c-353761903"
 },
 {
  "no": 22,
  "date": "2026-10-05",
  "title": "かぎがない",
  "line": "出かける直前に消えた鍵が、おままごとの鍋で煮えていた朝。",
  "image": "asakan/2026-10-05.jpg",
  "url": "https://substack.com/@shibe0/note/c-352953700"
 },
 {
  "no": 21,
  "date": "2026-10-04",
  "title": "かくれんぼ",
  "line": "隠れたのはいいけれど、見つけてもらうまで待てない日曜の朝。",
  "image": "asakan/2026-10-04.jpg",
  "url": "https://substack.com/@shibe0/note/c-352225510"
 },
 {
  "no": 20,
  "date": "2026-10-03",
  "title": "ねぞう",
  "line": "広いお布団で寝かしつけたのに、朝にはママだけ端っこで丸まっている休日の朝。",
  "image": "asakan/2026-10-03.jpg",
  "url": "https://substack.com/@shibe0/note/c-351472379"
 },
 {
  "no": 19,
  "date": "2026-10-02",
  "title": "ばんそうこう",
  "line": "痛くないところに貼ったばんそうこうで、箱が空になる朝。",
  "image": "asakan/2026-10-02.jpg",
  "url": "https://substack.com/@shibe0/note/c-350649070"
 },
 {
  "no": 18,
  "date": "2026-10-01",
  "title": "ミニカー",
  "line": "どうしても持っていくと言ったミニカーが、ママのポケットで出勤する朝。",
  "image": "asakan/2026-10-01.jpg",
  "url": "https://substack.com/@shibe0/note/c-349823133"
 },
 {
  "no": 17,
  "date": "2026-09-30",
  "title": "あめのあさ",
  "line": "子どもに傘をさしかけて、ママの肩だけぬれていく雨の朝。",
  "image": "asakan/2026-09-30.jpg",
  "url": "https://substack.com/@shibe0/note/c-348997610"
 },
 {
  "no": 16,
  "date": "2026-09-29",
  "title": "ぎゅうにゅう",
  "line": "上手に注げたと拍手した牛乳を、妹がひっくり返す朝。",
  "image": "asakan/2026-09-29.jpg",
  "url": "https://substack.com/@shibe0/note/c-348168967"
 },
 {
  "no": 15,
  "date": "2026-09-28",
  "title": "げつようび",
  "line": "行かないと泣いた保育園に、着いたとたん振り返らずに走っていく月曜の朝。",
  "image": "asakan/2026-09-28.jpg",
  "url": "https://substack.com/@shibe0/note/c-347371804"
 },
 {
  "no": 14,
  "date": "2026-09-27",
  "title": "シール",
  "line": "子どもにもらったシールが、夜まで背中で増えていた日曜日。",
  "image": "asakan/2026-09-27.jpg",
  "url": "https://substack.com/@shibe0/note/c-346633276"
 },
 {
  "no": 13,
  "date": "2026-09-26",
  "title": "おでかけ",
  "line": "行きたいと騒いだ公園に着いたとたん、ふたりそろって寝ている休日。",
  "image": "asakan/2026-09-26.jpg",
  "url": "https://substack.com/@shibe0/note/c-345894973"
 },
 {
  "no": 12,
  "date": "2026-09-25",
  "title": "スイッチ",
  "line": "妹が先に消した電気を、つけ直してから出かける朝。",
  "image": "asakan/2026-09-25.jpg",
  "url": "https://substack.com/@shibe0/note/c-345098520"
 },
 {
  "no": 11,
  "date": "2026-09-24",
  "title": "しずか",
  "line": "静かにしてくれて助かると思ったら、壁が画用紙になっていた朝。",
  "image": "asakan/2026-09-24.jpg",
  "url": "https://substack.com/@shibe0/note/c-344283113"
 },
 {
  "no": 10,
  "date": "2026-09-23",
  "title": "はみがき",
  "line": "上の子は口を閉じて逃げ、下の子は呼ばなくても口をあけて待つ朝。",
  "image": "asakan/2026-09-23.jpg",
  "url": "https://substack.com/@shibe0/note/c-343451557"
 },
 {
  "no": 9,
  "date": "2026-09-22",
  "title": "おむかえ",
  "line": "呼んでも帰らないのに、迎えは一番がいいと言われる夕方。",
  "image": "asakan/2026-09-22.jpg",
  "url": "https://substack.com/@shibe0/note/c-342629611"
 },
 {
  "no": 8,
  "date": "2026-09-21",
  "title": "おてつだい",
  "line": "手伝ってくれるほど、洗濯物がたたみ終わらない日。",
  "image": "asakan/2026-09-21.jpg",
  "url": "https://substack.com/@shibe0/note/c-341841413"
 },
 {
  "no": 7,
  "date": "2026-09-20",
  "title": "おかたづけ",
  "line": "きれいになったリビングが、三分でもとに戻る休日。",
  "image": "asakan/2026-09-20.jpg",
  "url": "https://substack.com/@shibe0/note/c-341112176"
 },
 {
  "no": 6,
  "date": "2026-09-19",
  "title": "どようび",
  "line": "平日はあんなに起きないのに、休みの日だけ日の出より早い朝。",
  "image": "asakan/2026-09-19.jpg",
  "url": "https://substack.com/@shibe0/note/c-340382345"
 },
 {
  "no": 5,
  "date": "2026-09-18",
  "title": "あさごはん",
  "line": "いらないと言われた朝ごはんが、ママの皿の上でだけ減る朝。",
  "image": "asakan/2026-09-18.jpg",
  "url": "https://substack.com/@shibe0/note/c-339588461"
 },
 {
  "no": 4,
  "date": "2026-09-17",
  "title": "ねるまえ",
  "line": "電気を消してから、用事が増えていく夜。",
  "image": "asakan/2026-09-17.jpg",
  "url": "https://substack.com/@shibe0/note/c-338790562"
 },
 {
  "no": 3,
  "date": "2026-09-16",
  "title": "ひとりじかん",
  "line": "早起きして淹れたコーヒーの湯気が消えるまでに、子どもたちも起きてくる朝。",
  "image": "asakan/2026-09-16.jpg",
  "url": "https://substack.com/@shibe0/note/c-337993370"
 },
 {
  "no": 2,
  "date": "2026-09-15",
  "title": "くつした",
  "line": "これじゃないと言われて探し出した靴下を、今度はいらないと言われる朝。",
  "image": "asakan/2026-09-15.jpg",
  "url": "https://substack.com/@shibe0/note/c-337198801"
 },
 {
  "no": 1,
  "date": "2026-09-14",
  "title": "おしっこ",
  "line": "トイレは行かないと言ったのに、靴を履いたら行きたくなる朝。",
  "image": "asakan/2026-09-14.jpg",
  "url": "https://substack.com/@shibe0/note/c-336430538"
 }
]
